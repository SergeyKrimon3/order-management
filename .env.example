# Local development only. Copy this file to .env.
# DBeaver and the API on your machine use localhost.
# When the API runs inside Docker, the host becomes the service name: postgres.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tmb-local
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

API_PORT=8080
WORKER_PORT=8081
FRONTEND_PORT=5173

RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

ConnectionStrings__Orders=Host=localhost;Port=5432;Database=tmb-local;Username=postgres;Password=postgres

# Obrigatório para perguntar sobre os pedidos. Qualquer API compatível com a OpenAI.
# Ollama na nuvem: https://ollama.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
