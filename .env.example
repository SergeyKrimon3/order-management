# Local development only. Copy this file to .env.
# DBeaver and the API on your machine use localhost.
# When the API runs inside Docker, the host becomes the service name: postgres.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orders
POSTGRES_PORT=5432

ConnectionStrings__Orders=Host=localhost;Port=5432;Database=orders;Username=postgres;Password=postgres
